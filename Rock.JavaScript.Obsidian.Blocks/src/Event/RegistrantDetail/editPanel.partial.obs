<template>
    <fieldset>
        <div class="row">
            <div class="col-md-6">
                <PersonPicker v-model="personAlias"
                              label="Person"
                              rules="required" />

                <Toggle v-if="props.modelValue.bag?.isWaitListEnabled"
                        v-model="isOnWaitList"
                        label="Status"
                        trueText="Wait List"
                        falseText="Registrant"
                        activeButtonCssClass="btn-info"
                        buttonSizeCssClass="btn-xs"
                        help="Moving someone from a wait list here will not send any emails to them. To send a formatted email use the Wait List tab." />

                <CurrencyBox v-model="cost"
                             label="Cost" />

                <CheckBox v-model="discountApplies"
                          label="Discount Applies" />

                <AttributeValuesContainer v-if="hasAttributes"
                                          v-model="attributeValues"
                                          :attributes="attributes"
                                          isEditMode
                                          :numberOfColumns="1" />
            </div>

            <div class="col-md-6" v-if="props.options.fees && props.options.fees?.length > 0">
                <ContentSection title="Fees" :disableCollapse="true">
                    <ContentStack v-for="fee in props.options.fees ?? []" :key="fee.id">

                        <!-- Multiple Items - Pick One -->
                        <template v-if="fee.feeType === RegistrationFeeType.Multiple && !fee.allowMultiple">
                            <div style="width: fit-content;">
                                <DropDownList
                                              :modelValue="getSelectedFeeItemId(fee)"
                                              @update:modelValue="setSelectedFeeItem(fee, $event)"
                                              :label="fee.name ?? ''"
                                              :items="feeDropdownItems(fee)"
                                              showBlankItem />
                            </div>
                        </template>

                        <!-- Multiple Items - Allow Pick Quantity -->
                        <template v-else-if="fee.feeType === RegistrationFeeType.Multiple && fee.allowMultiple">
                            <label class="control-label">{{ fee.name }}</label>
                            <NumberUpDown v-for="item in fee.items ?? []"
                                          :key="item.id"
                                          :modelValue="getFeeQuantity(fee.id, item.id)"
                                          @update:modelValue="setFeeQuantity(fee.id, item.id, $event)"
                                          :label="feeItemLabel(item)"
                                          :min="0"
                                          :max="item.maximumUsageCount ?? 100" />
                        </template>

                        <!-- Single Item - Only 1 Allowed -->
                        <CheckBox v-else-if="fee.feeType === RegistrationFeeType.Single && !fee.allowMultiple && fee.items && fee.items.length > 0"
                                  :modelValue="getFeeChecked(fee.id, fee.items[0].id)"
                                  @update:modelValue="setFeeChecked(fee.id, fee.items[0], $event)"
                                  :label="fee.name ?? ''"
                                  :help="fee.items[0].cost > 0 ? formatCurrency(fee.items[0].cost) : ''" />

                        <!-- Single Item - Multiple Allowed -->
                        <NumberUpDown v-else-if="fee.feeType === RegistrationFeeType.Single && fee.allowMultiple && fee.items && fee.items.length > 0"
                                      :modelValue="getFeeQuantity(fee.id, fee.items[0].id)"
                                      @update:modelValue="setFeeQuantity(fee.id, fee.items[0].id, $event)"
                                      :label="fee.name ?? ''"
                                      :min="0"
                                      :max="fee.items[0].maximumUsageCount ?? 100"
                                      :help="fee.items[0].cost > 0 ? formatCurrency(fee.items[0].cost) : ''" />
                    </ContentStack>
                </ContentSection>
            </div>
        </div>

        <NotificationBox v-if="props.modelValue.bag?.hasExistingSignatureDocument"
                         alertType="info">
            An existing valid signature document was found for this person and will be associated with this registrant.
        </NotificationBox>

        <!-- TODO: Signature document file uploader requires BinaryFile Guid — bag field needs to change from number to Guid string. -->
    </fieldset>
</template>

<script setup lang="ts">
    import { computed, PropType, ref, watch } from "vue";
    import AttributeValuesContainer from "@Obsidian/Controls/attributeValuesContainer.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import CurrencyBox from "@Obsidian/Controls/currencyBox.obs";
    import DropDownList from "@Obsidian/Controls/dropDownList.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import NumberUpDown from "@Obsidian/Controls/numberUpDown.obs";
    import PersonPicker from "@Obsidian/Controls/personPicker.obs";
    import Toggle from "@Obsidian/Controls/toggle.obs";
    import { setPropertiesBoxValue, watchPropertyChanges } from "@Obsidian/Utility/block";
    import { propertyRef, updateRefValue } from "@Obsidian/Utility/component";
    import { toCurrencyOrNull } from "@Obsidian/Utility/numberUtils";
    import { RegistrationFeeType } from "@Obsidian/Enums/Event/registrationFeeType";
    import { RegistrantBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrantDetail/registrantBag";
    import { RegistrantDetailOptionsBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrantDetail/registrantDetailOptionsBag";
    import { RegistrantFeeBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrantDetail/registrantFeeBag";
    import { RegistrationTemplateFeeBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrantDetail/registrationTemplateFeeBag";
    import { RegistrationTemplateFeeItemBag } from "@Obsidian/ViewModels/Blocks/Event/RegistrantDetail/registrationTemplateFeeItemBag";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";

    const props = defineProps({
        modelValue: {
            type: Object as PropType<ValidPropertiesBox<RegistrantBag>>,
            required: true
        },

        options: {
            type: Object as PropType<RegistrantDetailOptionsBag>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: ValidPropertiesBox<RegistrantBag>): void,
        (e: "propertyChanged", value: string): void
    }>();

    // #region Values

    const personAlias = propertyRef<ListItemBag | undefined>(props.modelValue.bag?.personAlias ?? undefined, "PersonAlias");
    const cost = propertyRef(props.modelValue.bag?.cost ?? 0, "Cost");
    const discountApplies = propertyRef(props.modelValue.bag?.discountApplies ?? false, "DiscountApplies");
    const isOnWaitList = propertyRef(props.modelValue.bag?.isOnWaitList ?? false, "IsOnWaitList");

    const attributes = ref(props.modelValue.bag?.attributes ?? {});
    const attributeValues = ref(props.modelValue.bag?.attributeValues ?? {});

    // Keyed as "feeId_feeItemId" → quantity (0 = not selected).
    const feeQuantities = ref<Record<string, number>>(buildFeeQuantities());

    const propRefs = [personAlias, cost, discountApplies, isOnWaitList];

    // #endregion

    // #region Computed Values

    const hasAttributes = computed((): boolean => {
        return Object.keys(attributes.value).length > 0;
    });

    // #endregion

    // #region Fee Helpers

    function feeKey(feeId: number, feeItemId: number): string {
        return `${feeId}_${feeItemId}`;
    }

    function getFeeQuantity(feeId: number, feeItemId: number): number {
        return feeQuantities.value[feeKey(feeId, feeItemId)] ?? 0;
    }

    function setFeeQuantity(feeId: number, feeItemId: number, quantity: number): void {
        feeQuantities.value = { ...feeQuantities.value, [feeKey(feeId, feeItemId)]: quantity };
    }

    function getFeeChecked(feeId: number, feeItemId: number): boolean {
        return getFeeQuantity(feeId, feeItemId) > 0;
    }

    function setFeeChecked(feeId: number, item: RegistrationTemplateFeeItemBag, checked: boolean): void {
        setFeeQuantity(feeId, item.id, checked ? 1 : 0);
    }

    /** Returns the string feeItemId of the currently selected item for a dropdown fee, or "" if none. */
    function getSelectedFeeItemId(fee: RegistrationTemplateFeeBag): string {
        for (const item of fee.items ?? []) {
            if (getFeeQuantity(fee.id, item.id) > 0) {
                return item.id.toString();
            }
        }

        return "";
    }

    /** Sets quantity=1 on the selected item and clears all other items for a dropdown fee. */
    function setSelectedFeeItem(fee: RegistrationTemplateFeeBag, itemIdValue: string | string[]): void {
        const itemIdStr = Array.isArray(itemIdValue)
            ? itemIdValue[0] ?? ""
            : itemIdValue;

        const selectedId = parseInt(itemIdStr) || 0;
        const updates: Record<string, number> = {};

        for (const item of fee.items ?? []) {
            updates[feeKey(fee.id, item.id)] = item.id === selectedId ? 1 : 0;
        }

        feeQuantities.value = { ...feeQuantities.value, ...updates };
    }

    /** Builds ListItemBag[] for a Multiple/!AllowMultiple fee dropdown. */
    function feeDropdownItems(fee: RegistrationTemplateFeeBag): ListItemBag[] {
        return (fee.items ?? []).map(item => ({
            value: item.id.toString(),
            text: feeItemLabel(item)
        }));
    }

    function buildFeeQuantities(): Record<string, number> {
        const map: Record<string, number> = {};

        for (const fee of props.modelValue.bag?.fees ?? []) {
            if (fee.registrationTemplateFeeItemId != null) {
                map[feeKey(fee.registrationTemplateFeeId, fee.registrationTemplateFeeItemId)] = fee.quantity;
            }
        }

        return map;
    }

    function buildFees(): RegistrantFeeBag[] {
        const fees: RegistrantFeeBag[] = [];

        for (const fee of props.options.fees ?? []) {
            for (const item of fee.items ?? []) {
                const qty = getFeeQuantity(fee.id, item.id);

                if (qty > 0) {
                    fees.push({
                        registrationTemplateFeeId: fee.id,
                        registrationTemplateFeeItemId: item.id,
                        quantity: qty,
                        cost: item.cost,
                        option: item.name ?? ""
                    });
                }
            }
        }

        return fees;
    }

    function feeItemLabel(item: RegistrationTemplateFeeItemBag): string {
        if (item.cost > 0) {
            return `${item.name ?? ""} (${formatCurrency(item.cost)})`;
        }

        return item.name ?? "";
    }

    function formatCurrency(value: number): string {
        return toCurrencyOrNull(value) ?? `$${value.toFixed(2)}`;
    }

    // #endregion

    // Watch for parental changes in our model value and update all our values.
    watch(() => props.modelValue, () => {
        updateRefValue(personAlias, props.modelValue.bag?.personAlias ?? undefined);
        updateRefValue(cost, props.modelValue.bag?.cost ?? 0);
        updateRefValue(discountApplies, props.modelValue.bag?.discountApplies ?? false);
        updateRefValue(isOnWaitList, props.modelValue.bag?.isOnWaitList ?? false);
        updateRefValue(attributes, props.modelValue.bag?.attributes ?? {});
        updateRefValue(attributeValues, props.modelValue.bag?.attributeValues ?? {});
        updateRefValue(feeQuantities, buildFeeQuantities());
    });

    // Emit the updated bag whenever any tracked value changes.
    watch([attributeValues, feeQuantities, ...propRefs], () => {
        const newValue: ValidPropertiesBox<RegistrantBag> = {
            bag: { ...props.modelValue.bag } as RegistrantBag
        };

        setPropertiesBoxValue(newValue, "personAlias", personAlias.value);
        setPropertiesBoxValue(newValue, "cost", cost.value);
        setPropertiesBoxValue(newValue, "discountApplies", discountApplies.value);
        setPropertiesBoxValue(newValue, "isOnWaitList", isOnWaitList.value);
        setPropertiesBoxValue(newValue, "attributeValues", attributeValues.value);
        setPropertiesBoxValue(newValue, "fees", buildFees());

        emit("update:modelValue", newValue);
    });

    watchPropertyChanges(propRefs, emit);
</script>
