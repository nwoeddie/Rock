<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          :itemTerm="options.isPersonMode ? 'Group Membership' : 'Group'"
          :entityTypeGuid="options.isPersonMode ? EntityType.GroupMember : EntityType.Group"
          stickyHeader
          liveUpdates
          :gridSettings="options.showFilter"
          :gridSettingsActive="hasActiveFilters"
          @gridSettingsClick="onGridSettingsClick"
          :onAddItem="config.isAddEnabled ? onAddItem : undefined"
          @selectItem="onSelectItem">

        <TextColumn name="name"
                    :title="options.showGroupPath ? 'Path' : 'Name'"
                    :field="options.showGroupPath ? 'path' : 'name'"
                    :filter="textValueFilter"
                    visiblePriority="xs" />

        <TextColumn v-if="options.showGroupTypeColumn"
                    name="groupType"
                    title="Group Type"
                    field="groupType"
                    :filter="pickExistingValueFilter"
                    visiblePriority="md" />

        <TextColumn v-if="options.showDescriptionColumn"
                    name="description"
                    title="Description"
                    field="description"
                    :filter="textValueFilter"
                    visiblePriority="lg" />

        <!-- Role — person mode only -->
        <TextColumn v-if="options.isPersonMode"
                    name="groupRole"
                    title="Role"
                    field="groupRole"
                    :filter="textValueFilter"
                    visiblePriority="sm" />

        <!-- Date Added — person mode only -->
        <DateColumn v-if="options.isPersonMode"
                    name="dateAdded"
                    title="Added"
                    field="dateAdded"
                    visiblePriority="md" />

        <!-- Member Count — GroupList mode only -->
        <NumberColumn v-if="!options.isPersonMode && options.showMemberCountColumn"
                      name="memberCount"
                      title="Members"
                      field="memberCount"
                      :filter="numberValueFilter"
                      headerClass="text-right"
                      itemClass="justify-content-end text-right"
                      visiblePriority="md" />

        <BooleanColumn v-if="options.showSystemColumn"
                       name="isSystem"
                       title="System"
                       field="isSystem"
                       :filter="booleanValueFilter"
                       headerClass="text-center"
                       itemClass="justify-content-center text-center"
                       visiblePriority="xs" />

        <BooleanColumn v-if="options.showActiveStatusColumn"
                       name="isActive"
                       title="Active"
                       field="isActive"
                       :filter="booleanValueFilter"
                       headerClass="text-center"
                       itemClass="justify-content-center text-center"
                       visiblePriority="xs" />

        <!-- Sync icon column — GroupList mode only (separate from delete, bug fix) -->
        <Column v-if="!options.isPersonMode"
                name="syncStatus"
                title=""
                width="42px"
                itemClass="grid-columncommand"
                visiblePriority="xs">
            <template #format="{ row }">
                <span v-if="row['isSynced']"
                      class="ti ti-switch-3"
                      title="Managed by Group Sync"></span>
            </template>
        </Column>

        <SecurityColumn v-if="options.showSecurityColumn" />

        <DeleteColumn :rowDisabled="isRowDeleteDisabled"
                      disableConfirmation
                      @click="onDeleteClick" />
    </Grid>

    <GridSettingsModal v-if="options.showFilter"
                       v-model="gridSettings"
                       v-model:visible="isGridSettingsVisible"
                       :options="options"
                       @close="isGridSettingsVisible = false" />

    <AddGroupMemberModal v-if="options.isPersonMode"
                         v-model:visible="isAddMemberVisible"
                         :options="options"
                         @added="onMemberAdded" />
</template>

<script setup lang="ts">
    import { useConfigurationValues, useInvokeBlockAction, usePersonPreferences } from "@Obsidian/Utility/block";
    import { EntityType } from "@Obsidian/SystemGuids/entityType";
    import Grid, { BooleanColumn, Column, TextColumn, DateColumn, NumberColumn, textValueFilter, numberValueFilter, booleanValueFilter, pickExistingValueFilter, DeleteColumn, SecurityColumn } from "@Obsidian/Controls/grid";
    import { alert, confirm } from "@Obsidian/Utility/dialogs";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { GroupListOptionsBag } from "@Obsidian/ViewModels/Blocks/Group/GroupList/groupListOptionsBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { NavigationUrlKey, PreferenceKey, GridSettingsOptions } from "./GroupList/types.partial";
    import { computed, reactive, ref, watch } from "vue";
    import GridSettingsModal from "./GroupList/gridSettingsModal.partial.obs";
    import AddGroupMemberModal from "./GroupList/addGroupMemberModal.partial.obs";

    const config = useConfigurationValues<ListBlockBox<GroupListOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    const options = computed(() => config.options ?? {} as GroupListOptionsBag);

    const isGridSettingsVisible = ref(false);
    const isAddMemberVisible = ref(false);

    const gridSettings = ref<GridSettingsOptions>({
        groupTypeIdKey: preferences.getValue(PreferenceKey.FilterGroupTypeIdKey),
        purposeIdKey: preferences.getValue(PreferenceKey.FilterPurposeIdKey),
        activeStatus: preferences.getValue(PreferenceKey.FilterActiveStatus) || "all"
    });

    const hasActiveFilters = computed(() =>
        !!gridSettings.value.groupTypeIdKey
        || !!gridSettings.value.purposeIdKey
        || (options.value.showActiveFilter && gridSettings.value.activeStatus !== "all")
    );

    // #endregion

    // #region Functions

    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    // #endregion

    // #region Event Handlers

    function onSelectItem(key: string): void {
        if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
            window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", key);
        }
    }

    function isRowDeleteDisabled(row: Record<string, unknown>): boolean {
        return row["canDelete"] === false;
    }

    async function onDeleteClick(key: string): Promise<void> {
        const row = gridData?.rows?.find(r => r["idKey"] === key);
        if (!row) {
            return;
        }

        const needsArchive = row["needsArchive"] as boolean;
        const name = row["name"] as string;
        const memberCount = row["memberCount"] as number;
        const isPersonMode = options.value.isPersonMode;

        let confirmMsg: string;
        if (isPersonMode) {
            confirmMsg = needsArchive
                ? `Are you sure you want to archive this person's membership in "${name}"?`
                : `Are you sure you want to remove this person from "${name}"?`;
        }
        else {
            confirmMsg = needsArchive
                ? `Are you sure you want to archive "${name}"?`
                : `Are you sure you want to delete "${name}"? This action will also remove ${memberCount} member(s).`;
        }

        const confirmed = await confirm(confirmMsg);
        if (!confirmed) {
            return;
        }

        const actionKey = isPersonMode ? (row["groupMemberIdKey"] as string) : key;
        const actionName = isPersonMode ? "DeleteMember" : "Delete";
        const result = await invokeBlockAction<string>(actionName, { key: actionKey });

        if (result.isSuccess) {
            if (gridData?.rows) {
                const index = gridData.rows.findIndex(r => r["idKey"] === key);
                if (index !== -1) {
                    gridData.rows.splice(index, 1);
                }
            }
        }
        else {
            await alert(result.errorMessage ?? "Unknown error while trying to delete.");
        }
    }

    function onAddItem(): void {
        if (options.value.isPersonMode) {
            isAddMemberVisible.value = true;
        }
        else {
            if (config.navigationUrls?.[NavigationUrlKey.DetailPage]) {
                window.location.href = config.navigationUrls[NavigationUrlKey.DetailPage].replace("((Key))", "0");
            }
        }
    }

    function onMemberAdded(): void {
        gridDataSource.value = loadGridData();
    }

    function onGridSettingsClick(): void {
        isGridSettingsVisible.value = true;
    }

    watch(gridSettings, async () => {
        preferences.setValue(PreferenceKey.FilterGroupTypeIdKey, gridSettings.value.groupTypeIdKey ?? "");
        preferences.setValue(PreferenceKey.FilterPurposeIdKey, gridSettings.value.purposeIdKey ?? "");
        preferences.setValue(PreferenceKey.FilterActiveStatus, gridSettings.value.activeStatus ?? "");
        await preferences.save();
        gridDataSource.value = loadGridData();
    });

    // #endregion

    gridDataSource.value = loadGridData();
</script>

<style scoped>
/*
    Custom columns persisted from the WebForms block with header-class/item-class of
    "grid-columncommand" receive flex: 1 1 10% from the grid by default because the
    CustomColumnDefinitionBag has no width field. Override to match the fixed-width
    command column convention used by built-in columns (delete, security, etc.).
*/
:deep(.grid-columncommand) {
    flex: 0 0 52px !important;
    min-width: unset !important;
}
</style>
