<template>
    <fieldset>
        <div class="row">
            <TextBox v-model="name"
                     label="Name"
                     textMode="singleLine"
                     :isReadOnly="true" />
        </div>
        <div class="row">
            <TextBox v-model="friendlyName"
                     label="Friendly Name"
                     textMode="singleLine" />
        </div>
        <div class="row">
            <div class="col-md-6">
                <CheckBox v-model="isCommon"
                          label="Common"
                          help="There are various places that a user is prompted for an entity type. 'Common' entities will be listed first for the user to easily find them" />
            </div>
            <div class="col-md-6">
                <CheckBox v-model="trackInteraction"
                          label="Track Interaction"
                          help="When enabled this will track which interaction was active when instances of this entity type are created." />
            </div>
        </div>
        <ContentStack>
            <CodeEditor v-model="indexResultTemplate"
                        label="Index Results Template"
                        help="The Lava used by the Universal Search feature to display results. Available merge fields include CurrentPerson, IndexDocument and DisplayOptions."
                        :isReadOnly="!isEditable"
                        language="lava" />
        </ContentStack>
        <ContentStack>
            <CodeEditor v-model="indexDocumentUrl"
                        label="Index Document URL Pattern"
                        help="The Lava used by the Universal Search feature to determine the Rock URL of the document. Available merge fields include CurrentPerson, IndexDocument and DisplayOptions."
                        :isReadOnly="!isEditable"
                        language="lava" />
        </ContentStack>
        <ContentStack>
            <CodeEditor v-model="linkUrlLavaTemplate"
                        label="Link URL Pattern"
                        help="The Lava used when Rock needs to create a URL to an entity based just on the entity type (ie. Tag Report). Available merge field is Entity."
                        :isReadOnly="!isEditable"
                        language="lava" />
        </ContentStack>
    </fieldset>
</template>

<script setup lang="ts">
    import { onMounted, PropType, ref, watch } from "vue";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import CheckBox from "@Obsidian/Controls/checkBox.obs";
    import { EntityTypesBag } from "@Obsidian/ViewModels/Blocks/Core/EntityTypes/entityTypesBag";
    import { ValidPropertiesBox } from "@Obsidian/ViewModels/Utility/validPropertiesBox";
    import { setPropertiesBoxValue } from "@Obsidian/Utility/block";
    import { updateRefValue } from "@Obsidian/Utility/component";
    import { tooltip } from "@Obsidian/Utility/tooltip";
    import CodeEditor from "@Obsidian/Controls/codeEditor.obs";
    import ContentStack from "@Obsidian/Controls/contentStack.obs";
    import ContentSection from "@Obsidian/Controls/contentSection.obs";
    const props = defineProps({
        modelValue: {
            type: Object as PropType<ValidPropertiesBox<EntityTypesBag>>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:modelValue", value: ValidPropertiesBox<EntityTypesBag>): void;
    }>();
    // #region Values
    const name = ref(props.modelValue.bag?.name ?? "");
    const friendlyName = ref(props.modelValue.bag?.friendlyName ?? "");
    const isCommon = ref(props.modelValue.bag?.isCommon ?? false);
    const trackInteraction = ref(props.modelValue.bag?.isRelatedToInteractionTrackedOnCreate ?? false);
    const indexResultTemplate = ref(props.modelValue.bag?.indexResultTemplate ?? "");
    const indexDocumentUrl = ref(props.modelValue.bag?.indexDocumentUrl ?? "");
    const linkUrlLavaTemplate = ref(props.modelValue.bag?.linkUrlLavaTemplate ?? "");
    const isEditable = ref(true);



    // #endregion

    // #region Computed Values

    // #endregion

    watch(() => props.modelValue, () => {
        updateRefValue(name, name.value);
    });

    // enable the tooltips for the badges
    const commonInfoRef = ref<Element | null>(null);
    const trackInteractionInfoRef = ref<Element | null>(null);
    onMounted(() => {
        if (commonInfoRef?.value) {
            tooltip(commonInfoRef.value);
        }
        if (trackInteractionInfoRef?.value) {
            tooltip(trackInteractionInfoRef.value);
        }
    });

    // Determines which values we want to track changes on (defined in the
    // array) and then emit a new object defined as newValue.
    watch([
        friendlyName], () => {
            const newValue: ValidPropertiesBox<EntityTypesBag> = {
                bag: { ...props.modelValue.bag } as EntityTypesBag
            };

            setPropertiesBoxValue(newValue, "friendlyName", friendlyName.value);

            emit("update:modelValue", newValue);
        });

</script>
