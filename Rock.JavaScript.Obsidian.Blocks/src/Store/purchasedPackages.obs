<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Panel type="block"
           title="Purchased Packages"
           titleIconCssClass="ti ti-gift">
        <template #headerActions>
            <RockButton :btnType="BtnType.Default"
                        :btnSize="BtnSize.ExtraSmall"
                        :isLoading="isRevoking"
                        @click="onRevokeStoreKey">
                Revoke Store Key
            </RockButton>
        </template>

        <!-- Store unavailable -->
        <NotificationBox v-if="storeErrorMessage" alertType="warning">
            <h4>Store Currently Not Available</h4>
            <p>We're sorry, the Rock Store is currently not available. Check back soon!</p>
            <small><em>{{ storeErrorMessage }}</em></small>
        </NotificationBox>

        <template v-else>
            <!-- Empty state -->
            <NotificationBox v-if="packages.length === 0" alertType="warning">
                No packages have been purchased for this organization.
            </NotificationBox>

            <div v-for="storePackage in packages"
                 :key="storePackage.packageId"
                 class="purchasedpackage row mb-4">
                <div class="col-md-3">
                    <img class="img-responsive mx-auto"
                         :src="storePackage.iconUrl ?? ''"
                         width="280"
                         height="140" />
                </div>
                <div class="col-md-7 mb-3">
                    <h1>{{ storePackage.name }}</h1>

                    <div class="clearfix mb-2">
                        <div class="pull-left">
                            <strong>Purchased</strong><br>
                            {{ formatPurchasedDate(storePackage.purchasedDate) }}
                        </div>
                        <div class="pull-right">
                            <strong>Purchased by</strong><br>
                            {{ storePackage.purchaser }}
                        </div>
                    </div>
                    <div v-html="storePackage.description"></div>
                    <div class="margin-t-md">
                        <a :href="storePackage.detailPageUrl ?? ''" class="btn btn-default btn-sm mb-2">Package Details</a>
                    </div>
                </div>
                <div class="col-md-2 purchasedpackage-install">
                    <a :href="storePackage.installPageUrl ?? ''"
                       class="btn btn-primary mb-3"
                       :class="{ disabled: !isInstallEnabled(storePackage) }">
                        {{ getInstallButtonText(storePackage) }}
                    </a>

                    <!-- Version notes -->
                    <p v-if="storePackage.installedVersionLabel">
                        <strong>Installed Version</strong><br>{{ storePackage.installedVersionLabel }}
                    </p>
                    <p v-if="storePackage.latestVersionLabel">
                        <strong>Latest Version</strong><br>{{ storePackage.latestVersionLabel }}
                    </p>
                </div>
            </div>
        </template>
    </Panel>
</template>

<script setup lang="ts">
    import { computed, onMounted, ref } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { PurchasedPackagesInitializationBox } from "@Obsidian/ViewModels/Blocks/Store/PurchasedPackages/purchasedPackagesInitializationBox";
    import { PurchasedPackageBag } from "@Obsidian/ViewModels/Blocks/Store/PurchasedPackages/purchasedPackageBag";
    import { PurchasedPackageInstallState } from "./PurchasedPackages/types.partial";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    // #region Values

    const config = useConfigurationValues<PurchasedPackagesInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();
    const reloadBlock = useReloadBlock();

    const isRevoking = ref(false);

    console.log("Config:", config);

    const installStateFields = <ListItemBag[]>[
        {
            text: "Not Available",
            value: "notAvailable"
        },
        {
            text: "Install",
            value: "install"
        },
        {
            text: "Update",
            value: "update"
        },
        {
            text: "Installed",
            value: "installed"
        }
    ];

    // #endregion Values

    // #region Computed Values

    const storeErrorMessage = computed((): string => config.storeErrorMessage ?? "");

    const packages = computed((): PurchasedPackageBag[] => config.purchasedPackages ?? []);

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Revokes the organization's store key, then reloads the block.
     */
    async function onRevokeStoreKey(): Promise<void> {
        isRevoking.value = true;

        try {
            // TODO: Handle the result / errors as needed.
            await invokeBlockAction("RevokeStoreKey");
            reloadBlock();
        }
        finally {
            isRevoking.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Functions

    /**
     * Returns the install button label for the package's install state.
     */
    function getInstallButtonText(storePackage: PurchasedPackageBag): string {
        switch (storePackage.installState) {
            case PurchasedPackageInstallState.Install:
                return "Install";
            case PurchasedPackageInstallState.Update:
                return "Update";
            case PurchasedPackageInstallState.Installed:
                return "Installed";
            default:
                return "Not available";
        }
    }

    /**
     * Returns whether the install button is actionable for the package.
     * Only the Install and Update states navigate to the install page.
     */
    function isInstallEnabled(storePackage: PurchasedPackageBag): boolean {
        return storePackage.installState === PurchasedPackageInstallState.Install
            || storePackage.installState === PurchasedPackageInstallState.Update;
    }

    /**
     * Formats the purchased date for display.
     */
    function formatPurchasedDate(_date: string | null | undefined): string {
        // TODO: Format the date ( legacy used M/d/yyyy ).
        return "";
    }

    // #endregion Functions

    // #region Lifecycle Hooks

    onMounted(() => {
        // When the store has not been configured, send the user to the Link
        // Organization page so they can configure it.
        if (!config.isStoreConfigured) {
            window.location.href = config.linkOrganizationPageUrl ?? "/RockShop";
        }
    });

    // #endregion Lifecycle Hooks
</script>
