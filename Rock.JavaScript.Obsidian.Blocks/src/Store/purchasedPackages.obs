<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Panel type="block"
           title="Purchased Packages"
           titleIconCssClass="ti ti-gift">
        <template #headerActions>
            <RockButton :btnType="BtnType.Default"
                        :btnSize="BtnSize.ExtraSmall"
                        :isLoading="isRevoking"
                        @click="onRevokeStoreKey">
                Revoke Store Key
            </RockButton>
        </template>

        <!-- Store unavailable -->
        <NotificationBox v-if="storeErrorMessage" alertType="warning">
            <h4>Store Currently Not Available</h4>
            <p>We're sorry, the Rock Store is currently not available. Check back soon!</p>
            <small><em>{{ storeErrorMessage }}</em></small>
        </NotificationBox>

        <template v-else>
            <!-- Empty state -->
            <NotificationBox v-if="packages.length === 0" alertType="warning">
                No packages have been purchased for this organization.
            </NotificationBox>

            <div class="purchasedpackage-list">
                <PurchasedPackageCard v-for="storePackage in packages"
                                      :key="storePackage.packageId"
                                      :storePackage="storePackage" />
            </div>
        </template>
    </Panel>
</template>

<style scoped>
.purchasedpackage-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-medium);
}
</style>

<script setup lang="ts">
    import { computed, onMounted, ref } from "vue";
    import Panel from "@Obsidian/Controls/panel.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import RockButton from "@Obsidian/Controls/rockButton.obs";
    import { BtnType } from "@Obsidian/Enums/Controls/btnType";
    import { BtnSize } from "@Obsidian/Enums/Controls/btnSize";
    import { useConfigurationValues, useInvokeBlockAction, useReloadBlock } from "@Obsidian/Utility/block";
    import { PurchasedPackagesInitializationBox } from "@Obsidian/ViewModels/Blocks/Store/PurchasedPackages/purchasedPackagesInitializationBox";
    import { PurchasedPackageBag } from "@Obsidian/ViewModels/Blocks/Store/PurchasedPackages/purchasedPackageBag";
    import PurchasedPackageCard from "./PurchasedPackages/purchasedPackageCard.partial.obs";

    // #region Values

    const config = useConfigurationValues<PurchasedPackagesInitializationBox>();
    const invokeBlockAction = useInvokeBlockAction();
    const reloadBlock = useReloadBlock();

    const isRevoking = ref(false);

    // #endregion Values

    // #region Computed Values

    const storeErrorMessage = computed((): string => config.storeErrorMessage ?? "");

    const packages = computed((): PurchasedPackageBag[] => config.purchasedPackages ?? []);

    // #endregion Computed Values

    // #region Event Handlers

    /**
     * Revokes the organization's store key, then reloads the block.
     */
    async function onRevokeStoreKey(): Promise<void> {
        isRevoking.value = true;

        try {
            // TODO: Handle the result / errors as needed.
            await invokeBlockAction("RevokeStoreKey");
            reloadBlock();
        }
        finally {
            isRevoking.value = false;
        }
    }

    // #endregion Event Handlers

    // #region Lifecycle Hooks

    onMounted(() => {
        // When the store has not been configured, send the user to the Link
        // Organization page so they can configure it.
        if (!config.isStoreConfigured) {
            window.location.href = config.linkOrganizationPageUrl ?? "/RockShop";
        }
    });

    // #endregion Lifecycle Hooks
</script>
