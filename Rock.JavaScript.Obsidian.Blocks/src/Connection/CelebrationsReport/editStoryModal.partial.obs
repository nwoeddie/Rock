<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Modal v-model="isVisible"
           title="Edit Celebration Story"
           saveText="Save"
           @save="onSave">

        <div class="row">
            <div class="col-md-6">
                <PersonPicker v-model="selectedAuthor"
                              help="Sets who should be listed as the person who recorded this story."
                              label="Author" />
            </div>
        </div>

        <TextBox v-model="storyText"
                 label="Story Details"
                 textMode="multiline"
                 :rows="6" />

    </Modal>
</template>

<script setup lang="ts">
    import { PropType, ref, watch } from "vue";
    import Modal from "@Obsidian/Controls/modal.obs";
    import PersonPicker from "@Obsidian/Controls/personPicker.obs";
    import TextBox from "@Obsidian/Controls/textBox.obs";
    import { useVModelPassthrough } from "@Obsidian/Utility/component";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    const props = defineProps({
        noteIdKey: {
            type: String as PropType<string>,
            required: true
        },

        initialText: {
            type: String as PropType<string>,
            default: ""
        },

        /** The current author represented as a ListItemBag (value = PersonAlias Guid, text = full name). */
        initialAuthor: {
            type: Object as PropType<ListItemBag | undefined>,
            default: undefined
        },

        visible: {
            type: Boolean as PropType<boolean>,
            required: true
        }
    });

    const emit = defineEmits<{
        (e: "update:visible", value: boolean): void;
        (e: "save", noteIdKey: string, text: string, authorPersonAliasGuid: string | undefined): void;
    }>();

    const isVisible = useVModelPassthrough(props, "visible", emit);
    const storyText = ref(props.initialText);
    const selectedAuthor = ref<ListItemBag | undefined>(props.initialAuthor);

    /** Emit save event then close. */
    function onSave(): void {
        emit("save", props.noteIdKey, storyText.value, selectedAuthor.value?.value ?? undefined);
        isVisible.value = false;
    }

    // Resync local state when the modal is opened with a new row.
    watch(() => props.initialText, (val) => {
        storyText.value = val;
    });

    watch(() => props.initialAuthor, (val) => {
        selectedAuthor.value = val;
    });
</script>
