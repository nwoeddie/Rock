<!-- Copyright by the Spark Development Network; Licensed under the Rock Community License -->
<template>
    <Grid :definition="config.gridDefinition ?? undefined"
          :data="gridDataSource"
          keyField="idKey"
          itemTerm="Celebration"
          stickyHeader
          liveUpdates
          gridSettings
          :gridSettingsActive="hasActiveFilters"
          @gridSettingsClick="isGridSettingsVisible = true"
          @selectItem="onSelectItem">

        <DateColumn name="date"
                    title="Date"
                    field="date"
                    :filter="dateValueFilter"
                    visiblePriority="xs" />

        <PersonColumn name="requester"
                      title="Requester"
                      field="requester"
                      :showAsLink="true"
                      visiblePriority="xs" />

        <TextColumn v-if="!gridSettings.connectionType"
                    name="type"
                    title="Type"
                    field="type"
                    :filter="textValueFilter"
                    visiblePriority="md" />

        <TextColumn name="opportunity"
                    title="Opportunity"
                    field="opportunity"
                    :filter="textValueFilter"
                    visiblePriority="md" />

        <Column name="storyDetails"
                title="Story Details"
                field="storyDetails"
                :filter="textValueFilter"
                visiblePriority="xs"
                width="35%">
            <template #format="{ row }">
                <div class="celebration-story-cell">
                    <span v-if="row.storyAuthorName" class="story-author">{{ row.storyAuthorName }}: </span>{{ row.storyDetails }}
                </div>
            </template>
        </Column>

        <Column name="connectionRequestLink"
                title=""
                field="connectionRequestIdKey"
                width="52px"
                :excludeFromExport="true"
                visiblePriority="xs">
            <template #format="{ row }">
                <a v-if="connectionRequestDetailPageUrl && row.connectionRequestIdKey"
                   :href="connectionRequestDetailPageUrl.replace('((Key))', row.connectionRequestIdKey as string)"
                   target="_blank"
                   class="btn btn-default btn-sm btn-square"
                   title="View Connection Request">
                    <i class="ti ti-external-link"></i>
                </a>
            </template>
        </Column>

    </Grid>

    <GridSettingsModal v-model="gridSettings"
                       v-model:visible="isGridSettingsVisible"
                       :connectionTypeItems="connectionTypeItems" />

    <EditStoryModal v-if="selectedStory"
                    v-model:visible="isEditStoryVisible"
                    :noteIdKey="selectedStory.idKey"
                    :initialText="selectedStory.storyDetails"
                    :initialAuthor="selectedStory.storyAuthorPersonAliasGuid
                        ? { value: selectedStory.storyAuthorPersonAliasGuid, text: selectedStory.storyAuthorName }
                        : undefined"
                    @save="onStorySave" />
</template>

<script setup lang="ts">
    import { computed, reactive, ref, watch } from "vue";
    import GridSettingsModal from "./CelebrationsReport/gridSettingsModal.partial.obs";
    import EditStoryModal from "./CelebrationsReport/editStoryModal.partial.obs";
    import { GridSettingsOptions, NavigationUrlKey, PreferenceKey } from "./CelebrationsReport/types.partial";
    import Grid, { DateColumn, PersonColumn, TextColumn, Column, dateValueFilter, textValueFilter } from "@Obsidian/Controls/grid";
    import { useConfigurationValues, useInvokeBlockAction, usePersonPreferences } from "@Obsidian/Utility/block";
    import { RangeType, TimeUnit, parseSlidingDateRangeString, slidingDateRangeToString } from "@Obsidian/Utility/slidingDateRange";
    import { safeParseJson } from "@Obsidian/Utility/stringUtils";
    import { ListBlockBox } from "@Obsidian/ViewModels/Blocks/listBlockBox";
    import { CelebrationsReportOptionsBag } from "@Obsidian/ViewModels/Blocks/Connection/CelebrationsReport/celebrationsReportOptionsBag";
    import { GridDataBag } from "@Obsidian/ViewModels/Core/Grid/gridDataBag";
    import { ListItemBag } from "@Obsidian/ViewModels/Utility/listItemBag";

    type SelectedStory = {
        idKey: string;
        storyDetails: string;
        storyAuthorName: string;
        storyAuthorPersonAliasGuid: string;
    };

    const config = useConfigurationValues<ListBlockBox<CelebrationsReportOptionsBag>>();
    const invokeBlockAction = useInvokeBlockAction();
    const preferences = usePersonPreferences().blockPreferences;

    // #region Values

    const gridDataSource = ref<Promise<GridDataBag>>();
    let gridData: GridDataBag | undefined;

    const isGridSettingsVisible = ref(false);
    const isEditStoryVisible = ref(false);
    const selectedStory = ref<SelectedStory | null>(null);

    const defaultDateRange = { rangeType: RangeType.Last, timeValue: 8, timeUnit: TimeUnit.Month };
    const dateRangePrefValue = preferences.getValue(PreferenceKey.FilterDateRange);
    const savedDateRange = parseSlidingDateRangeString(dateRangePrefValue);

    const gridSettings = ref<GridSettingsOptions>({
        slidingDateRange: savedDateRange ?? defaultDateRange,
        connectionType: safeParseJson<ListItemBag>(preferences.getValue(PreferenceKey.FilterConnectionTypeGuid)) ?? null
    });

    // #endregion

    // #region Computed Values

    const connectionTypeItems = computed((): ListItemBag[] => {
        return config.options?.connectionTypes ?? [];
    });

    const connectionRequestDetailPageUrl = computed((): string => {
        return config.navigationUrls?.[NavigationUrlKey.ConnectionRequestDetailPage] ?? "";
    });

    /** Gear icon is active when a connection type is selected or a date range preference is explicitly saved. */
    const hasActiveFilters = computed((): boolean => {
        return !!gridSettings.value.connectionType
            || preferences.getValue(PreferenceKey.FilterDateRange) !== "";
    });

    // #endregion

    // #region Functions

    /**
     * Called when the grid is requesting the row data be loaded.
     */
    async function loadGridData(): Promise<GridDataBag> {
        const result = await invokeBlockAction<GridDataBag>("GetGridData");

        if (result.isSuccess && result.data) {
            gridData = reactive(result.data);
            return gridData;
        }
        else {
            throw new Error(result.errorMessage ?? "Unknown error while trying to load grid data.");
        }
    }

    /**
     * Called when the user clicks a row. Opens the edit story modal.
     */
    function onSelectItem(key: string): void {
        const row = gridData?.rows?.find(r => r["idKey"] === key);
        if (!row) {
            return;
        }

        selectedStory.value = {
            idKey: row["idKey"] as string,
            storyDetails: (row["storyDetails"] as string) ?? "",
            storyAuthorName: (row["storyAuthorName"] as string) ?? "",
            storyAuthorPersonAliasGuid: (row["storyAuthorPersonAliasGuid"] as string) ?? ""
        };
        isEditStoryVisible.value = true;
    }

    /**
     * Called when the edit story modal saves. Updates the note via block action
     * and refreshes the matching grid row on success.
     */
    async function onStorySave(noteIdKey: string, text: string, authorPersonAliasGuid: string | undefined): Promise<void> {
        const result = await invokeBlockAction<{ storyAuthorName: string; storyAuthorPersonAliasGuid: string }>(
            "SaveCelebrationStory",
            { key: noteIdKey, text, authorPersonAliasGuid: authorPersonAliasGuid ?? null }
        );

        if (result.isSuccess && gridData?.rows) {
            const row = gridData.rows.find(r => r["idKey"] === noteIdKey);
            if (row) {
                row["storyDetails"] = text;
                row["storyAuthorName"] = result.data?.storyAuthorName ?? "";
                row["storyAuthorPersonAliasGuid"] = result.data?.storyAuthorPersonAliasGuid ?? "";
            }
        }
    }

    // #endregion

    watch(gridSettings, async () => {
        const settings = gridSettings.value;

        preferences.setValue(
            PreferenceKey.FilterDateRange,
            settings.slidingDateRange ? slidingDateRangeToString(settings.slidingDateRange) : ""
        );

        preferences.setValue(
            PreferenceKey.FilterConnectionTypeGuid,
            settings.connectionType ? JSON.stringify(settings.connectionType) : ""
        );

        await preferences.save();
        gridDataSource.value = loadGridData();
    });

    gridDataSource.value = loadGridData();
</script>

<style>
.celebration-story-cell {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.story-author {
    font-weight: 600;
}
</style>
